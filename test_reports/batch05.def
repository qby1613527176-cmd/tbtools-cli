# 批5定义文件 — 树 + MSA + 进化 全量回归
# 格式: ID<TAB>DESC<TAB>EXPECT正则<TAB>CMD
# 数据: examples/data/phylogeny, treeRooting, marker, align + test_reports/data_b5/（自造距离）

T501	tree TreeMeta多轨道树	B5OK=SVG_OK	cd /home/elysia/tbtools-cli && rm -f /tmp/b5/tree.svg && bin/tbplot.sh tree test_reports/data_b5/tree.config /tmp/b5/tree.svg >/dev/null 2>&1; [ -s /tmp/b5/tree.svg ] && echo "B5OK=SVG_OK" || echo "B5OK=0"
T502	phylotree 系统发育树视图	B5OK=SVG_OK	cd /home/elysia/tbtools-cli && rm -f /tmp/b5/phylo.svg && bin/tbplot.sh phylotree examples/data/phylogeny/phylo.nwk /tmp/b5/phylo.svg >/dev/null 2>&1; [ -s /tmp/b5/phylo.svg ] && echo "B5OK=SVG_OK" || echo "B5OK=0"
T503	unrooted 无根树可视化	B5OK=SVG_OK	cd /home/elysia/tbtools-cli && rm -f /tmp/b5/unrooted.svg && bin/tbplot.sh unrooted examples/data/phylogeny/phylo.nwk /tmp/b5/unrooted.svg >/dev/null 2>&1; [ -s /tmp/b5/unrooted.svg ] && echo "B5OK=SVG_OK" || echo "B5OK=0"
T504	treeRooting MAD定根	B5OK=ROOTED	cd /home/elysia/tbtools-cli && rm -f /tmp/b5/rooted.nwk && bin/tbplot.sh treeRooting examples/data/treeRooting/unrooted.nwk /tmp/b5/rooted.nwk >/dev/null 2>&1; [ -s /tmp/b5/rooted.nwk ] && echo "B5OK=ROOTED" || echo "B5OK=0"
T505	msa MSA可视化	B5OK=SVG_OK	cd /home/elysia/tbtools-cli && rm -f /tmp/b5/msa.svg && bin/tbplot.sh msa examples/data/phylogeny/msa.fa /tmp/b5/msa.svg >/dev/null 2>&1; [ -s /tmp/b5/msa.svg ] && echo "B5OK=SVG_OK" || echo "B5OK=0"
T506	nwAlign Needleman-Wunsch双序列比对	B5OK=NW	cd /home/elysia/tbtools-cli && rm -f /tmp/b5/nw.out && bin/tbplot.sh nwAlign examples/data/align/nw.seq1.txt examples/data/align/nw.seq2.txt /tmp/b5/nw.out >/dev/null 2>&1; [ -s /tmp/b5/nw.out ] && echo "B5OK=NW" || echo "B5OK=0"
T507	hclust 三列距离聚类树	B5OK=HCLUST	cd /home/elysia/tbtools-cli && rm -f /tmp/b5/hc.nwk && bin/tbplot.sh hclust test_reports/data_b5/dist_real.tsv /tmp/b5/hc.nwk >/dev/null 2>&1; [ -s /tmp/b5/hc.nwk ] && echo "B5OK=HCLUST" || echo "B5OK=0"
T508	onesteptree 一步法ML树	B5OK=MLTREE	cd /home/elysia/tbtools-cli && rm -rf /tmp/b5/ot && mkdir -p /tmp/b5/ot && timeout 280 bin/tbplot.sh onesteptree --inPepFie examples/data/rpc/gras6_pep.fa --outFilePrefix /tmp/b5/ot --bbTime 1000 >/dev/null 2>&1; [ -s /tmp/b5/ot/TBtools.IQtree.contree ] && echo "B5OK=MLTREE" || echo "B5OK=0"
T509	marker MarkerFilter 标记过滤	B5OK=MF	cd /home/elysia/tbtools-cli && rm -f /tmp/b5/mf.out && bin/tbplot.sh marker MarkerFilter examples/data/marker/markers_0-1.tsv /tmp/b5/mf.out >/dev/null 2>&1; [ -s /tmp/b5/mf.out ] && echo "B5OK=MF" || echo "B5OK=0"
T510	marker MarkerDist 标记距离	B5OK=MD	cd /home/elysia/tbtools-cli && rm -f /tmp/b5/md.out && bin/tbplot.sh marker MarkerDist examples/data/marker/markers_0-1.tsv /tmp/b5/md.out >/dev/null 2>&1; [ -s /tmp/b5/md.out ] && echo "B5OK=MD" || echo "B5OK=0"
T511	marker SampleDist 样本距离	B5OK=SD	cd /home/elysia/tbtools-cli && rm -f /tmp/b5/sd.out && bin/tbplot.sh marker SampleDist examples/data/marker/markers_0-1.tsv /tmp/b5/sd.out >/dev/null 2>&1; [ -s /tmp/b5/sd.out ] && echo "B5OK=SD" || echo "B5OK=0"
T512	markertools filter 等位频率过滤	B5OK=MKF	cd /home/elysia/tbtools-cli && out=$(bin/tbplot.sh markertools filter examples/data/marker/markers_0-1.tsv 2>&1); [ -n "$out" ] && echo "B5OK=MKF" || echo "B5OK=0"
T513	markertools dist 样本距离	B5OK=MKD	cd /home/elysia/tbtools-cli && out=$(bin/tbplot.sh markertools dist examples/data/marker/markers_0-1.tsv 2>&1); [ -n "$out" ] && echo "B5OK=MKD" || echo "B5OK=0"
T514	markertools sampledist 群体距离	B5OK=MKS	cd /home/elysia/tbtools-cli && out=$(bin/tbplot.sh markertools sampledist examples/data/marker/markers_0-1.tsv 2>&1); [ -n "$out" ] && echo "B5OK=MKS" || echo "B5OK=0"
T515	findBestForkerRootTree 最佳叉根（已知 NPE 暂缓，预期 SKIP）	B5OK=SKIP	cd /home/elysia/tbtools-cli && rm -f /tmp/b5/fbrt.nwk && bin/tbtools tool findBestForkerRootTree --inTreeFile examples/data/phylogeny/phylo.nwk --outFile /tmp/b5/fbrt.nwk >/dev/null 2>&1; [ -s /tmp/b5/fbrt.nwk ] && echo "B5OK=PASS_EXPECTED_NPE" || echo "B5OK=SKIP"