# 批8定义文件 — 特殊绘图 + 组装/注释/其他模块 全量回归
# 格式: ID<TAB>DESC<TAB>EXPECT正则<TAB>CMD
# 注: colorscheme refColIndex 为 1-based（CLI 内部-1）；mirnatarget 用 osa-miR171a（阳性对照配套）

T801	rnaplot RNA二级结构图	B8OK=SVG_OK	cd /home/elysia/tbtools-cli && mkdir -p /tmp/b8 && printf '>seq1\nGGGAAACCCGGGAAACCC\n' > /tmp/b8/rna.fa && rm -f /tmp/b8/rna.svg && timeout 120 bin/tbplot.sh rnaplot /tmp/b8/rna.fa /tmp/b8/rna.svg >/dev/null 2>&1; [ -s /tmp/b8/rna.svg ] && echo "B8OK=SVG_OK" || echo "B8OK=0"
T802	mountain RNA山峰图	B8OK=MT	cd /home/elysia/tbtools-cli && printf '(((...))).((...)).\n' > /tmp/b8/fold.txt && rm -f /tmp/b8/mt.tsv && timeout 90 bin/tbplot.sh mountain /tmp/b8/fold.txt /tmp/b8/mt.tsv >/dev/null 2>&1; [ -s /tmp/b8/mt.tsv ] && echo "B8OK=MT" || echo "B8OK=0"
T803	colorscheme 表格配色（1-based）	B8OK=CS	cd /home/elysia/tbtools-cli && rm -f /tmp/b8/cs1.tsv && timeout 90 bin/tbplot.sh colorscheme examples/data/expr/expr.tsv /tmp/b8/cs1.tsv 1 >/dev/null 2>&1; [ -s /tmp/b8/cs1.tsv ] && echo "B8OK=CS" || echo "B8OK=0"
T804	distance 距离计算（stdout）	B8OK=DST	cd /home/elysia/tbtools-cli && out=$(timeout 90 bin/tbplot.sh distance examples/data/expr/expr.tsv 1 2 euclidean 2>&1); [ -n "$out" ] && echo "B8OK=DST" || echo "B8OK=0"
T805	gel 凝胶电泳图	B8OK=SVG_OK	cd /home/elysia/tbtools-cli && rm -f /tmp/b8/gel.svg && timeout 120 bin/tbplot.sh gel "798;1233,228;1688,1598" "Marker,1,2,3" "2000,1500,1000,750,500,250,100" /tmp/b8/gel.svg >/dev/null 2>&1; [ -s /tmp/b8/gel.svg ] && echo "B8OK=SVG_OK" || echo "B8OK=0"
T806	gfa GFA组装图	B8OK=SVG_OK	cd /home/elysia/tbtools-cli && rm -f /tmp/b8/gfa.svg && timeout 120 bin/tbplot.sh gfa examples/data/fasta/sample.gfa /tmp/b8/gfa.svg >/dev/null 2>&1; [ -s /tmp/b8/gfa.svg ] && echo "B8OK=SVG_OK" || echo "B8OK=0"
T807	microgenome 质体环形图	B8OK=SVG_OK	cd /home/elysia/tbtools-cli && rm -f /tmp/b8/mg.svg && timeout 120 bin/tbplot.sh microgenome examples/data/genome/plasmid_full.gbk examples/data/genome/plasmid_anno3.txt /tmp/b8/mg.svg >/dev/null 2>&1; [ -s /tmp/b8/mg.svg ] && echo "B8OK=SVG_OK" || echo "B8OK=0"
T808	virusRecomb 病毒重组分析	B8OK=PDF_OK	cd /home/elysia/tbtools-cli && rm -rf /tmp/b8/vr && mkdir -p /tmp/b8/vr && timeout 180 bin/tbplot.sh virusRecomb examples/data/virus/virus.db.fa examples/data/virus/query.contig.fa /tmp/b8/vr >/dev/null 2>&1; ls /tmp/b8/vr/*.pdf >/dev/null 2>&1 && echo "B8OK=PDF_OK" || echo "B8OK=0"
T809	preparespecies 物种前缀准备	B8OK=PS	cd /home/elysia/tbtools-cli && rm -rf /tmp/b8/ps && mkdir -p /tmp/b8/ps && timeout 120 bin/tbplot.sh preparespecies SP1 examples/data/comparative/input.genome.fa examples/data/comparative/input.gff /tmp/b8/ps/SP1.genome.fa /tmp/b8/ps/SP1.gff >/dev/null 2>&1; [ -s /tmp/b8/ps/SP1.genome.fa ] && echo "B8OK=PS" || echo "B8OK=0"
T810	goParse GO词典解析	B8OK=GOP	cd /home/elysia/tbtools-cli && timeout 120 bin/tbplot.sh goParse examples/data/go/gene2go.sample.txt ~/R/library/GSEABase/extdata/goslim_plant.obo >/dev/null 2>&1; ls examples/data/go/gene2go.sample.txt.TBtools.Parsed.Gene2Go.xls >/dev/null 2>&1 && echo "B8OK=GOP" || echo "B8OK=0"
T811	levelGo GO层级统计	B8OK=LG	cd /home/elysia/tbtools-cli && rm -rf /tmp/b8/lg && mkdir -p /tmp/b8/lg && timeout 120 bin/tbplot.sh levelGo examples/data/go/gene2go.sample.txt /tmp/b8/lg/level2.xls ~/R/library/GSEABase/extdata/goslim_plant.obo --level 2 >/dev/null 2>&1; [ -s /tmp/b8/lg/level2.xls ] && echo "B8OK=LG" || echo "B8OK=0"
T812	ctgGroup 组装辅助contig分组	B8OK=CTG	cd /home/elysia/tbtools-cli && rm -f /tmp/b8/ctg.out && timeout 150 bin/tbplot.sh ctgGroup examples/data/assembly/miniprot.gff 2 /tmp/b8/ctg.out >/dev/null 2>&1; [ -s /tmp/b8/ctg.out ] && echo "B8OK=CTG" || echo "B8OK=0"
T813	homoPhase 同源相位分离	B8OK=HP	cd /home/elysia/tbtools-cli && rm -f /tmp/b8/hp.out && timeout 150 bin/tbplot.sh homoPhase /tmp/b8/ctg.out /tmp/b8/hp.out >/dev/null 2>&1; [ -s /tmp/b8/hp.out ] && echo "B8OK=HP" || echo "B8OK=0"
T814	sepChr 染色体分组	B8OK=SC	cd /home/elysia/tbtools-cli && rm -f /tmp/b8/sc.out && timeout 150 bin/tbplot.sh sepChr examples/data/assembly/gene2chr.tsv examples/data/assembly/miniprot.gff /tmp/b8/sc.out >/dev/null 2>&1; [ -s /tmp/b8/sc.out ] && echo "B8OK=SC" || echo "B8OK=0"
T815	mirnatarget miRNA靶标预测	B8OK=MT1	cd /home/elysia/tbtools-cli && printf '>osa-miR171a\nGAUAUUGGCGCGGCUCAAUCA\n' > /tmp/b8/mir171.fa && rm -f /tmp/b8/mt1.tsv && timeout 200 bin/tbplot.sh mirnatarget /tmp/b8/mir171.fa examples/data/mirna/mirnaIdentify/positive_ctrl_genome.fa /tmp/b8/mt1.tsv --evalue 10 >/dev/null 2>&1; [ -s /tmp/b8/mt1.tsv ] && echo "B8OK=MT1" || echo "B8OK=0"
T816	mirnaTarget2 全量靶标管线	B8OK=MT2	cd /home/elysia/tbtools-cli && rm -f /tmp/b8/mt2.txt && timeout 150 bin/tbplot.sh mirnaTarget2 examples/data/mirna/miRNA.fa examples/data/mirna/mirnaIdentify/positive_ctrl_genome.fa /tmp/b8/mt2.txt >/dev/null 2>&1; [ -s /tmp/b8/mt2.txt ] && echo "B8OK=MT2" || echo "B8OK=0"
T817	mirnaIdentify miRNA前体鉴定（阳性对照）	B8OK=MI	cd /home/elysia/tbtools-cli && rm -f /tmp/b8/mi.txt && timeout 200 bin/tbplot.sh mirnaIdentify examples/data/mirna/mirnaIdentify/positive_ctrl_genome.fa examples/data/mirna/mirnaIdentify/positive_ctrl_target.tsv /tmp/b8/mi.txt /tmp/b8/mi.log >/dev/null 2>&1; [ -s /tmp/b8/mi.txt ] && echo "B8OK=MI" || echo "B8OK=0"
