# 批4定义文件 — 核心绘图 I：基因结构/Motif/热图/eFP/域图 全量回归
# 格式: ID<TAB>DESC<TAB>EXPECT正则<TAB>CMD
# 数据: test_reports/data_b4/（prep 脚本 + 真实 GRAS meme）

T401	genestructure 基因结构图	B4OK=SVG_OK	cd /home/elysia/tbtools-cli && bin/tbplot.sh genestructure examples/data/gene_structure.gff examples/data/ids.txt /tmp/b4/gs.svg >/dev/null 2>&1; [ -s /tmp/b4/gs.svg ] && echo "B4OK=SVG_OK" || echo "B4OK=0"
T402	motif Motif分布图（真实GRAS meme）	B4OK=SVG_OK	cd /home/elysia/tbtools-cli && bin/tbplot.sh motif test_reports/data_b4/meme_real.xml test_reports/data_b4/meme_ids.txt /tmp/b4/motif.svg >/dev/null 2>&1; [ -s /tmp/b4/motif.svg ] && echo "B4OK=SVG_OK" || echo "B4OK=0"
T403	seqlogo 序列LOGO	B4OK=SVG_OK	cd /home/elysia/tbtools-cli && bin/tbplot.sh seqlogo examples/data/phylogeny/msa.fa /tmp/b4/logo.svg >/dev/null 2>&1; [ -s /tmp/b4/logo.svg ] && echo "B4OK=SVG_OK" || echo "B4OK=0"
T404	heatmap2 聚类热图	B4OK=SVG_OK	cd /home/elysia/tbtools-cli && bin/tbplot.sh heatmap2 examples/data/expression2/expr_matrix.tsv /tmp/b4/hm2.svg >/dev/null 2>&1; [ -s /tmp/b4/hm2.svg ] && echo "B4OK=SVG_OK" || echo "B4OK=0"
