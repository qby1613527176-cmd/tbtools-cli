# 批3定义文件 — 表达计算 + 统计绘图 + 表格工具 全量回归
# 格式: ID<TAB>DESC<TAB>EXPECT正则<TAB>CMD

T301	rpkmCal RPKM计算	B3OK=[1-9]	cd /home/elysia/tbtools-cli && rm -rf /tmp/b3 && mkdir -p /tmp/b3 && bin/tbtools tool rpkmCal --countsTable examples/data/expression/counts.tsv --lenInfo examples/data/expression/gene_len.tsv --outTable /tmp/b3/rpkm.xls >/dev/null 2>&1; echo "B3OK=$(wc -l < /tmp/b3/rpkm.xls 2>/dev/null)"
T302	tpmCalc TPM计算	B3OK=[1-9]	cd /home/elysia/tbtools-cli && bin/tbtools tool tpmCalc --countsTable examples/data/expression/counts.tsv --lenInfo examples/data/expression/gene_len.tsv --outTable /tmp/b3/tpm.xls >/dev/null 2>&1; echo "B3OK=$(wc -l < /tmp/b3/tpm.xls 2>/dev/null)"
T303	fpkmToTpm FPKM转TPM	B3OK=[1-9]	cd /home/elysia/tbtools-cli && bin/tbtools tool fpkmToTpm --fpkmTable examples/data/expression/RPKM.out.tsv --tpmTable /tmp/b3/ft.xls >/dev/null 2>&1; echo "B3OK=$(wc -l < /tmp/b3/ft.xls 2>/dev/null)"
T304	tauIndex 组织特异性指数	B3OK=[1-9]	cd /home/elysia/tbtools-cli && bin/tbplot.sh tauIndex examples/data/expression2/expr_matrix.tsv /tmp/b3/tau.xls >/dev/null 2>&1; echo "B3OK=$(wc -l < /tmp/b3/tau.xls 2>/dev/null)"
T305	exprCorr 样本相关矩阵	B3OK=[1-9]	cd /home/elysia/tbtools-cli && bin/tbplot.sh exprCorr examples/data/expression2/expr_matrix.tsv /tmp/b3/corr.xls >/dev/null 2>&1; echo "B3OK=$(wc -l < /tmp/b3/corr.xls 2>/dev/null)"
T306	qpcrExp qPCR相对表达	B3OK=[1-9]	cd /home/elysia/tbtools-cli && bin/tbplot.sh qpcrExp examples/data/expr/qpcr.txt /tmp/b3/qpe.xls >/dev/null 2>&1; echo "B3OK=$(wc -l < /tmp/b3/qpe.xls 2>/dev/null)"
T307	qpcrproc qPCR ddCt分析	B3OK=[1-9]	cd /home/elysia/tbtools-cli && bin/tbplot.sh qpcrproc examples/data/qpcr/qpcr_ddct.input.tab /tmp/b3/qpp.xls >/dev/null 2>&1; echo "B3OK=$(wc -l < /tmp/b3/qpp.xls 2>/dev/null)"
T308	pca PCA绘图	B3OK=SVG_OK	cd /home/elysia/tbtools-cli && bin/tbplot.sh pca examples/data/expression2/expr_matrix.tsv /tmp/b3/pca.svg >/dev/null 2>&1; [ -s /tmp/b3/pca.svg ] && echo "B3OK=SVG_OK" || echo "B3OK=0"
T309	volcano 火山图(官方deg 500行)	B3OK=SVG_OK	cd /home/elysia/tbtools-cli && bin/tbplot.sh volcano examples/data/deg.txt /tmp/b3/vol.svg 0.05 1.0 >/dev/null 2>&1; [ -s /tmp/b3/vol.svg ] && echo "B3OK=SVG_OK" || echo "B3OK=0"
T310	dehist 差异表达双直方图	B3OK=SVG_OK	cd /home/elysia/tbtools-cli && bin/tbplot.sh dehist examples/data/expr/deg_hist.tsv /tmp/b3/dehist.svg >/dev/null 2>&1; [ -s /tmp/b3/dehist.svg ] && echo "B3OK=SVG_OK" || echo "B3OK=0"
T311	qpcr 柱状图	B3OK=SVG_OK	cd /home/elysia/tbtools-cli && bin/tbplot.sh qpcr examples/data/expr/qpcr.txt /tmp/b3/qpcr.svg >/dev/null 2>&1; [ -s /tmp/b3/qpcr.svg ] && echo "B3OK=SVG_OK" || echo "B3OK=0"
T312	groupedbar 分组柱状图	B3OK=SVG_OK	cd /home/elysia/tbtools-cli && bin/tbplot.sh groupedbar examples/data/expr/groupbar.tsv /tmp/b3/gbar.svg BAR_ERROR SEM >/dev/null 2>&1; [ -s /tmp/b3/gbar.svg ] && echo "B3OK=SVG_OK" || echo "B3OK=0"
T313	barplot 富集柱状图	B3OK=SVG_OK	cd /home/elysia/tbtools-cli && bin/tbplot.sh barplot examples/data/misc/enrich.tsv /tmp/b3/bar.svg Term Pvalue >/dev/null 2>&1; [ -s /tmp/b3/bar.svg ] && echo "B3OK=SVG_OK" || echo "B3OK=0"
T314	batchReplace 批量替换	B3OK=[1-9]	cd /home/elysia/tbtools-cli && bin/tbplot.sh batchReplace examples/data/table/batchReplace.in.txt /tmp/b3/br.out examples/data/table/batchReplace.patternMap.tsv >/dev/null 2>&1; echo "B3OK=$(grep -c CAM /tmp/b3/br.out 2>/dev/null)"
T315	tableCollapse 按键折叠	B3OK=[1-9]	cd /home/elysia/tbtools-cli && bin/tbplot.sh tableCollapse examples/data/table/tableCollapse.in.tsv 1 /tmp/b3/tc.out >/dev/null 2>&1; echo "B3OK=$(wc -l < /tmp/b3/tc.out 2>/dev/null)"
T316	tableColSelect 按列名选列	B3OK=[1-9]	cd /home/elysia/tbtools-cli && bin/tbplot.sh tableColSelect examples/data/table/reshape/colsel.in.tsv /tmp/b3/tcs.out Root Flower >/dev/null 2>&1; echo "B3OK=$(wc -l < /tmp/b3/tcs.out 2>/dev/null)"
T317	tableAppend 按列合并	B3OK=[1-9]	cd /home/elysia/tbtools-cli && bin/tbplot.sh tableAppend examples/data/table/reshape/tab1.txt examples/data/table/reshape/tab2.txt /tmp/b3/ta.out >/dev/null 2>&1; echo "B3OK=$(wc -l < /tmp/b3/ta.out 2>/dev/null)"
T318	tableMelt 宽转长	B3OK=[1-9]	cd /home/elysia/tbtools-cli && bin/tbplot.sh tableMelt examples/data/table/reshape/melt.in.tsv /tmp/b3/melt.out >/dev/null 2>&1; echo "B3OK=$(wc -l < /tmp/b3/melt.out 2>/dev/null)"
T319	tableColSel 正则选列	B3OK=[1-9]	cd /home/elysia/tbtools-cli && bin/tbplot.sh tableColSel examples/data/table/reshape/colsel.in.tsv /tmp/b3/cols.out examples/data/table/reshape/colsel.idlist.txt >/dev/null 2>&1; echo "B3OK=$(wc -l < /tmp/b3/cols.out 2>/dev/null)"
T320	tableCast 长转宽	B3OK=[1-9]	cd /home/elysia/tbtools-cli && bin/tbplot.sh tableCast examples/data/table/reshape/cast.in.tsv /tmp/b3/cast.out >/dev/null 2>&1; echo "B3OK=$(wc -l < /tmp/b3/cast.out 2>/dev/null)"
T321	tableUniq 去重	B3OK=[1-9]	cd /home/elysia/tbtools-cli && bin/tbplot.sh tableUniq examples/data/table/uniq/uniq.in.txt /tmp/b3/tu.out >/dev/null 2>&1; echo "B3OK=$(wc -l < /tmp/b3/tu.out 2>/dev/null)"
T322	tableTranspose 转置	B3OK=[1-9]	cd /home/elysia/tbtools-cli && bin/tbplot.sh tableTranspose examples/data/table/uniq/transpose.in.tsv /tmp/b3/tt.out >/dev/null 2>&1; echo "B3OK=$(wc -l < /tmp/b3/tt.out 2>/dev/null)"
T323	tableSplit 按列拆分	B3OK=[1-9]	cd /home/elysia/tbtools-cli && rm -rf /tmp/b3/split && mkdir -p /tmp/b3/split && bin/tbplot.sh tableSplit examples/data/table/uniq/split.in.tsv /tmp/b3/split --colIndex 1 >/dev/null 2>&1; echo "B3OK=$(ls /tmp/b3/split 2>/dev/null | wc -l)"
T324	tableMerge 多表合并	B3OK=[1-9]	cd /home/elysia/tbtools-cli && bin/tbplot.sh tableMerge /tmp/b3/tm.out examples/data/table/uniq/m1.txt examples/data/table/uniq/m2.txt >/dev/null 2>&1; echo "B3OK=$(wc -l < /tmp/b3/tm.out 2>/dev/null)"
T325	groupCol 样本按组折叠	B3OK=[1-9]	cd /home/elysia/tbtools-cli && printf 'A\tG1\nB\tG1\nC\tG2\nD\tG2\nE\tG2\n' > /tmp/b3/grp.tsv && bin/tbplot.sh groupCol examples/data/expr/expr.tsv /tmp/b3/grp.tsv /tmp/b3/grp.out Mean >/dev/null 2>&1; echo "B3OK=$(wc -l < /tmp/b3/grp.out 2>/dev/null)"
