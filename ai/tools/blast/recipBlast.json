{
 "schema_version": "1.0",
 "id": "tbtools.blast.recipBlast",
 "name": "recipBlast",
 "group": "blast",
 "kind": "direct",
 "class": "biocjava.bioDoer.BLAST.ReciprocalBlast.ReciprocalBlast",
 "description": "RBH 双向最优比对（ArgsParser 风格：参数必须 --key value 形态；依赖系统 blastp/makeblastdb）",
 "invoke": "tbtools blast recipBlast <args...>",
 "capabilities": [
  "homology",
  "reciprocal_best_hit",
  "blast"
 ],
 "inputs": [
  {
   "name": "query",
   "role": "file",
   "format": "fasta",
   "required": true,
   "note": "",
   "content_type": "protein"
  },
  {
   "name": "subject",
   "role": "file",
   "format": "fasta",
   "required": true,
   "note": "",
   "content_type": "protein"
  }
 ],
 "outputs": [
  "tsv"
 ],
 "status": "stable"
}