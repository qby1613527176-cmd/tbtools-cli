# tool-run 对 -jar 引擎误写 jar 旁 provenance 的残留
plugins/lib/*.tbtools.json
# conformance 运行 provenance(每次跑刷新, 非版本内容)
examples/data/**/*.tbtools.json
nonexist.txt.tbtools.json

# 引擎运行中间产物(自审 verified F4: 不入库, 测试 tmp 生成)
examples/data/exec/**/_engine_cache/
examples/data/exec/**/*.sorted.sam
examples/data/exec/**/*.sai
examples/data/exec/**/*.TBtools.fa
examples/data/exec/**/*.fai

# PyPI 发布构建产物(发布时点验证证据快照; 真源= tests/verification_report.json)
tbtools_cli/verification_report.json

# P2-5(五视角自审): 根级运行痕迹——notung 测试副产物/provenance 写回
*.reconciled
