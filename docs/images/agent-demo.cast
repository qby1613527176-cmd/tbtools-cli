[1.08472, "o", "{\r\n \"query\": null,\r\n \"hits\": [\r\n  {\r\n   \"name\": \"dehist\",\r\n   \"group\": \"expr\",\r\n   \"kind\": \"manual\",\r\n   \"description\": \"差异表达双直方图\"\r\n  },\r\n  {\r\n   \"name\": \"volcano\",\r\n   \"group\": \"expr\",\r\n"]
[2.102088, "o", "\r\n$ tbtools tool-describe volcano --json   # ② 理解 schema(列名/参数契约)\r\n"]
[2.189322, "o", "{\r\n \"uri\": \"tbtools://expr/volcano\",\r\n \"inputs\": [\r\n  {\r\n   \"name\": \"deg\",\r\n   \"role\": \"file\",\r\n   \"format\": \"tsv\",\r\n   \"required\": true,\r\n   \"note\": \"GeneID\\tLog2FC\\tpvalue\",\r\n   \"columns\": [\r\n    \"GeneID\",\r\n    \"Log2FC\",\r\n    \"pvalue\"\r\n   ]\r\n  }\r\n ],\r\n \"parameters\": [\r\n  {\r\n   \"name\": \"pval_cutoff\",\r\n   \"type\": \"float\",\r\n   \"default\": 0.05,\r\n   \"required\": false,\r\n   \"note\": \"\",\r\n   \"cli_name\": \"--pval-cutoff\"\r\n  },\r\n  {\r\n   \"name\": \"fc_cutoff\",\r\n   \"type\": \"float\",\r\n   \"default\": 1.0,\r\n   \"required\": false,\r\n   \"note\": \"\",\r\n   \"cli_name\": \"--fc-cutoff\"\r\n  }\r\n ]\r\n}\r\n"]
[3.194383, "o", "\r\n$ tbtools tool-validate volcano examples/data/deg.txt --json   # ③ 预检\r\n"]
[3.263676, "o", "{\r\n \"command\": \"volcano\",\r\n \"valid\": true,\r\n \"checks\": [\r\n  {\r\n   \"input\": \"examples/data/deg.txt\",\r\n   \"ok\": true,\r\n   \"format\": \"tsv\",\r\n   \"columns\": 3,\r\n   \"warning\": null\r\n  }\r\n ]\r\n}\r\n"]
[4.278558, "o", "\r\n$ tbtools tool-run expr volcano examples/data/deg.txt demo_v.svg --json   # ④ 执行(纯 JSON)\r\n"]
