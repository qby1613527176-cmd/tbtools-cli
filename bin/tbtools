#!/usr/bin/env bash
# ============================================================
# tbtools — TBtools-II 全功能 CLI 统一入口（GitHub 发布版）
# ============================================================
# 覆盖四层能力：
#   1. RPC 数据工具（188 方法）— rpc/methods/server
#   2. 绘图引擎（97 个）— genestructure/motif/.../venn6/multisyn/efpHeat
#   3. 命令行工具（82 个）— tool
#   5. 版本/诊断 — version/doctor
#   4. 任意引擎反射 — engine
#
# 依赖：TBtools_JRE1.6.jar（详见 README）
# ============================================================
set -e

# ---------- 定位项目根 ----------
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(dirname "$SCRIPT_DIR")"

# ---------- 加载配置 ----------
# shellcheck disable=SC1091
source "$ROOT/config/config.sh"

# ---------- 转发函数 ----------
run_plot() {
    bash "$ROOT/bin/tbplot.sh" "$@"
}
run_rpc() {
    bash "$ROOT/bin/tbtools_rpc.sh" "$@"
}
run_tool() {
    python3 "$ROOT/bin/tbcli.py" "$@"
}
run_engine() {
    bash "$ROOT/bin/tbengine.sh" "$@"
}

usage() {
    cat <<'EOF'
tbtools — TBtools-II 全功能 CLI
================================
绘图命令（140 个）:
  # 📊 绘图/分析（140 个，tbplot.sh <命令>）:
  #   基因结构/序列: genestructure motif seqlogo msa
  #   表达/统计:     volcano pca hclust qpcr groupedbar dehist barplot heatmap2 layoutheatmap cubeheatmap
  #   树/进化:       tree phylotree unrooted treeRooting onesteptree hclust nwAlign amazingmeta cddmotif pfammotif seqlentrack
  #   共线性/基因组: circos supercircos circlegene dotplot microsyn msy multisyn dualsyn pafviz pafcomp pafref
  #   集合/ChIP:     venn2-6 upset peakdist peaktss peakanno pileup
  #   其他:          gel gfa plotrna rnaplot colorscheme distance mountain microgenome virusRecomb ...
  tbtools plot <命令> [参数...]   # 绘图统一入口（转发 tbplot.sh）
  tbtools list plots              # 列出全部绘图命令
  tbplot.sh help                  # 查看全部绘图命令

RPC 数据工具（188 方法）:
  tbtools rpc <method> '<json>'      # 调用任意 RPC
  tbtools methods                    # 列出 188 方法
  tbtools server start|stop          # RPC 服务器管理
  tbtools heatmap <matrix> <out> [group]  # 热图快捷

命令行工具（82 个）:
  tbtools tool statFasta --inFasta x.fa --outPutFile y.xls    # FASTA 统计
  tbtools tool rpkmCal --countsTable c.tsv --lenInfo l.tsv --outTable r.xls  # RPKM 计算
  tbtools tool tpmCalc --countsTable c.tsv --lenInfo l.tsv --outTable t.xls  # TPM 计算
  tbtools tool mimicVqsrCutoffFind ...                       # GWAS 质控
  tbtools list tools                                          # 列出全部 82 个工具

任意引擎反射（万能兜底）:
  tbtools engine <引擎类> key=value [--call 方法]

环境变量:
  TBTOOLS_JAR     TBtools jar 路径（必需）
  TBTOOLS_JAVA    java 可执行（默认 JAVA_HOME/bin/java）
  TBTOOLS_RPC_PORT RPC 端口（默认 8765）

其他:
  tbtools version    # 查看版本
  tbtools doctor     # 环境诊断
  tbtools examples   # 命令示例
  tbtools help       # 本帮助
EOF
}

case "${1:-}" in
  # ======== RPC 层 ========
  rpc) shift
    # 兼容 tbtools rpc <method> '<json>'（文档形式，内部补 call）和 tbtools rpc call <method> '<json>'（直通）
    case "${1:-}" in
      call|describe|methods|list|start|stop|heatmap) run_rpc "$@";;
      *) run_rpc call "$@";;
    esac
    ;;
  methods) run_rpc methods;;
  server) shift; run_rpc "$@";;
  heatmap) shift; run_rpc heatmap "$@";;

  # ======== 命令行工具 ========
  tool) shift; run_tool tool "$@";;
  list) shift; run_tool list "$@";;

  # ======== 绘图（转发 tbplot.sh，经 tbcli.py cmd_plot） ========
  plot) shift; run_tool plot "$@";;

  # ======== 任意引擎反射 ========
  engine) shift; run_engine "$@";;

  # ======== 绘图引擎（全部 97 个） ========
  genestructure|motif|volcano|genelocation|dotplot|circos|hclust|qpcr|pca|\
  upset|msa|genelocgff|tree|heatmap2|supercircos|barplot|pafviz|admixture|\
  groupedbar|layoutheatmap|cubeheatmap|efpHeat|circlegene|seqlogo|peaktss|peakdist|\
  dehist|msy|venn5|venn6|microsyn|multisyn|marker|treeRooting|findblockdual|collinearRegion|findblockmultiple|visualizeblock|conflictpaf|partitionconflict|mirnatarget|mirnaTarget2|mirnaIdentify|preparespecies|bamstate|bamMerge|hicEnzyme|virusRecomb|qpcrExp|tauIndex|exprCorr|groupCol|batchReplace|levelGo|goParse|tableCollapse|tableColSelect|tableAppend|tableMelt|tableColSel|tableCast|tableUniq|tableTranspose|tableSplit|tableMerge|fqTrim|gfa2fa|fastaSubseq|fastaExtract|fqfaConv|hmmExtract|mastExtract|nwAlign|twoSeqBlast|recipBlast|filterCScore|quickFamily|ctgGroup|homoPhase|sepChr|gxfRename|gxfStat|gxfAppend|gxfGenepos|gxfRegion|gxfFix|gxfOverlap|gxfRepIDs|gxfRepGXF|gxfMatch|gxfRecall|regionAnno|generic)
    CMD="$1"; shift
    run_plot "$CMD" "$@"
    ;;

  version|--version|-V) python3 "$ROOT/bin/tbcli.py" version;;
  doctor) python3 "$ROOT/bin/tbcli.py" doctor;;
  examples) python3 "$ROOT/bin/tbcli.py" examples "${@:2}";;
  help|-h|--help) usage;;
  *)
    if [ -z "${1:-}" ]; then usage
    elif grep -qE "^  ${1}\)" "$ROOT/bin/tbplot.sh"; then
      # 命令存在于 tbplot.sh 但主入口未显式路由 → 自动降级转发（08/31 盲测 P1 修复）
      run_plot "$@"
    else
      echo "❌ 未知命令: $1" >&2; usage; exit 1
    fi
    ;;
esac
